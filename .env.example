# Groq Reasoning Engine
GROQ_API_KEY="your_groq_api_key_here"
GROQ_FALLBACK_API_KEY="your_fallback_groq_api_key_here"
GROQ_MODEL="openai/gpt-oss-120b"
GROQ_GUARD_MODEL="qwen/qwen3.8-27b"

# Portkey LLM Gateway
PORTKEY_API_KEY="your_portkey_api_key_here"

# Qdrant Vector DB Settings 
QDRANT_API_KEY="your_qdrant_api_key_here"
QDRANT_CLUSTER_ENDPOINT="https://your-cluster-endpoint.cloud.qdrant.io"

# === Observability ===

# Pydantic Logfire Observability
LOGFIRE_TOKEN="your_logfire_token_here"

# LangSmith Tracing
LANGSMITH_TRACING=true
LANGSMITH_ENDPOINT="https://api.smith.langchain.com"
LANGSMITH_API_KEY="your_langsmith_api_key_here"
LANGSMITH_PROJECT="RAGPROJECT"

BACKEND_URL="http://localhost:8000"

# Gemini Embeddings
GEMINI_API_KEY="your_gemini_api_key_here"
